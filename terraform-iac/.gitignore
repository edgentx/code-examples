# Provider plugins and module cache. Downloaded by `init`, never committed.
.terraform/

# State. Local state is a working artifact of running this example offline; it
# also holds the generated bootstrap tokens in the clear, which is reason enough
# on its own. A real estate keeps state in a remote backend -- see the README.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Rendered output. Generated by `apply`; the source of truth is the tfvars file
# and the module, not the files they produce.
generated/
.tftest-output/

# Dependency lock file. Deliberately ignored *here* and only here -- the README
# explains why, and why your own repository should commit it.
.terraform.lock.hcl

# Variable files that would carry real values. This example's terraform.tfvars
# is synthetic and is committed on purpose; anything auto-loaded beyond it is not.
*.auto.tfvars
*.auto.tfvars.json
